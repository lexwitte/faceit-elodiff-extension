{
  "manifest_version": 3,
  "name": "FACEIT Elo Diff",
  "description": "Compare current, last-season, and peak ELO for every FACEIT CS2 match room player, with win odds.",
  "version": "0.4.0",
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.faceit.com/*"
  ],
  "icons": {
    "16": "logo.png",
    "32": "logo.png",
    "48": "logo.png",
    "128": "logo.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.faceit.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["logo.png"],
      "matches": ["https://www.faceit.com/*"]
    }
  ]
}
